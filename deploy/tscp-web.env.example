# 复制到 /etc/tscp-web.env 并按需修改（这个文件不应该进版本库）。

# 必改：会话签名密钥。生成方法：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TSCP_SECRET_KEY=change-me

# 数据库与用户剧情包的存放位置
TSCP_DATA_DIR=/var/lib/tscp-web

# 监听地址与端口
TSCP_HOST=0.0.0.0
TSCP_PORT=8888

# 单次请求大小上限（MB）。传大 FLAC 时要够大，nginx 的 client_max_body_size 也要跟上。
TSCP_MAX_UPLOAD_MB=512

# 走 HTTPS 之后设为 1，否则会话 Cookie 会在明文里发送
TSCP_SECURE_COOKIES=0

# 是否允许公开注册。设为 0 后只能由管理员建号。
TSCP_ALLOW_REGISTRATION=1

# 第一个注册的账号是否自动成为管理员
TSCP_FIRST_USER_IS_ADMIN=1

# 反向代理层数：前面挂了 nginx 就设 1，直接对外则设 0
TSCP_PROXY_HOPS=0
